# --- StarEastStore environment configuration -------------------------------
# Copy this file to `.env` and adjust the values. NEVER commit a real `.env`.

# Core
DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://www.example.com,https://example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (PostgreSQL). Leave unset to use the SQLite development fallback.
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce

# Localisation
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# Email - the console backend simply prints emails to the terminal.
# For production use something like:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=StarEastStore <no-reply@example.com>
ADMIN_EMAIL_NOTIFICATIONS=orders@example.com

# Shop rules
CURRENCY=$
TAX_RATE=0.00
FREE_SHIPPING_THRESHOLD=75

# Payment gateways (leave blank to disable that gateway at checkout)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The built-in demo gateway: enabled automatically while DEBUG=True.
SIMULATED_GATEWAY_ENABLED=True

# Production hardening (only meaningful when DEBUG=False)
SECURE_SSL_REDIRECT=False
BEHIND_PROXY=False
SECURE_COOKIES=True
STATIC_MANIFEST=False

# Seed command demo admin (seed_data only - change immediately in production)
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=demo@example.com
DEMO_CUSTOMER_PASSWORD=
